-- Helper: distance from center
local function screenDistanceFromCenter(worldPos)
    local camera = Workspace.CurrentCamera
    if not camera then return math.huge, false end
    local vp, onScreen = camera:WorldToViewportPoint(worldPos)
    local center = camera.ViewportSize * 0.5
    local dx = vp.X - center.X
    local dy = vp.Y - center.Y
    return math.sqrt(dx * dx + dy * dy), onScreen
end

-- Helper: visibility check using Raycast
local function isPartVisibleToCamera(part)
    local camera = Workspace.CurrentCamera
    if not camera or not part then return false end
    local origin = camera.CFrame.Position
    local direction = (part.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, direction, rayParams)
    if not result then return false end
    return result.Instance and (result.Instance:IsDescendantOf(part.Parent))
end

-- Create highlight for a character safely
function createHighlightForCharacter(player, character)
    if not player or not character then return end
    if highlights[player] and highlights[player].Parent then
        pcall(function() highlights[player]:Destroy() end)
        highlights[player] = nil
    end
    local ok, _ = pcall(function()
        local hl = Instance.new("Highlight")
        hl.Adornee = character
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.OutlineColor = Color3.fromRGB(0,0,0)
        hl.Parent = ScreenGui
        highlights[player] = hl
    end)
end

-- Ensure highlight exists / update color
local function ensureAndUpdateHighlight(player)
    if not espEnabled then return end
    if player == LocalPlayer then return end
    if ignoreTeam and player.Team == LocalPlayer.Team then
        if highlights[player] then
            pcall(function() highlights[player]:Destroy() end)
            highlights[player] = nil
        end
        return
    end
    local char = player.Character
    if not char then
        if highlights[player] then
            pcall(function() highlights[player]:Destroy() end)
            highlights[player] = nil
        end
        return
    end
    if not highlights[player] or not highlights[player].Parent then
        createHighlightForCharacter(player, char)
    end
    local hl = highlights[player]
    if hl and hl.Parent then
        if espVisibleCheck and char:FindFirstChild("HumanoidRootPart") then
            hl.FillColor = isPartVisibleToCamera(char.HumanoidRootPart) and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,0,0)
        else
            hl.FillColor = Color3.fromRGB(255,255,0)
        end
    end
end

-- Track players joining / leaving & respawns
local function onPlayerAdded(player)
    player.CharacterAdded:Connect(function(char)
        task.wait(0.4)
        if espEnabled then
            createHighlightForCharacter(player, char)
        end
        originalPartProps[player] = originalPartProps[player] or {}
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    onPlayerAdded(p)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
    if highlights[player] then
        pcall(function() highlights[player]:Destroy() end)
        highlights[player] = nil
    end
    originalPartProps[player] = nil
end)

-- Save original part props helper
local function saveOriginalPartProps(player, partName, part)
    if not player or not partName or not part then return end
    originalPartProps[player] = originalPartProps[player] or {}
    if not originalPartProps[player][partName] then
        local ok, res = pcall(function()
            return {
                Size = part.Size,
                Transparency = part.Transparency,
                Material = part.Material,
                CanCollide = part.CanCollide
            }
        end)
        if ok and res then
            originalPartProps[player][partName] = res
        end
    end
end

-- Restore original part props helper
local function restoreOriginalPartPropsFor(player, partName)
    if not player or not partName then return end
    local parts = originalPartProps[player]
    if not parts then return end
    local props = parts[partName]
    if not props then return end
    local char = player.Character
    if not char then return end
    local p = char:FindFirstChild(partName)
    if p and p:IsA("BasePart") then
        pcall(function()
            p.Size = props.Size
            p.Transparency = props.Transparency
            p.Material = props.Material
            p.CanCollide = props.CanCollide
        end)
    end
    parts[partName] = nil
end

-- Apply hitbox expansion to a player's currentPart (safe)
local function applyHitboxToPlayer(player)
    if not toggled then return end
    if player == LocalPlayer then return end
    if ignoreTeam and player.Team == LocalPlayer.Team then return end
    local char = player.Character
    if not char then return end
    local part = char:FindFirstChild(currentPart)
    if not part or not part:IsA("BasePart") then return end

    -- FOV check if enabled
    if fovEnabled then
        local dist, onScreen = screenDistanceFromCenter(part.Position)
        if (not onScreen) or dist > fovRadius then
            -- restore if we had previously changed it
            restoreOriginalPartPropsFor(player, currentPart)
            return
        end
    end

    -- store original props if not stored
    saveOriginalPartProps(player, currentPart, part)

    local sizeNum = tonumber(SizeBox.Text) or 6
    local s = math.clamp(sizeNum, 1, 20)  -- allow up to 20 but clamp for safety

    pcall(function()
        part.Size = Vector3.new(s, s, s)
        part.CanCollide = false
        if visible then
            part.Transparency = 0.5
            part.Material = Enum.Material.ForceField
        else
            part.Transparency = 1
            part.Material = Enum.Material.Plastic
        end
    end)
end

-- Regular reapply loop (every 1 second) to handle respawn / new players / missed cases
task.spawn(function()
    while true do
        -- ESP reapply & color update
        if espEnabled then
            for _, player in pairs(Players:GetPlayers()) do
                ensureAndUpdateHighlight(player)
            end
        else
            -- destroy any leftover highlights if disabled
            for _, hl in pairs(highlights) do
                if hl and hl.Parent then
                    pcall(function() hl:Destroy() end)
                end
            end
            highlights = {}
        end

        -- Reapply hitboxes for all players (best-effort), so respawned chars get hitboxes
        if toggled then
            for _, player in pairs(Players:GetPlayers()) do
                applyHitboxToPlayer(player)
            end
        end

        task.wait(1)
    end
end)

-- RenderStepped loop: visuals centering + continuous hitbox updates for responsiveness
RunService.RenderStepped:Connect(function()
    local camera = Workspace.CurrentCamera
    if camera then
        local center = camera.ViewportSize * 0.5
        -- center scope dot and circle in pixel coordinates (works reliably on mobile)
        if scopeEnabled then
            scopeDot.Position = UDim2.new(0, center.X, 0, center.Y)
            scopeDot.AnchorPoint = Vector2.new(0.5, 0.5)
        end
        if fovEnabled then
            FovCircle.Position = UDim2.new(0, center.X, 0, center.Y)
            FovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
        end
    end

    -- Continuous hitbox application (keeps parts sized while alive)
    if toggled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(currentPart) then
                if ignoreTeam and player.Team == LocalPlayer.Team then
                    -- skip teammates
                else
                    applyHitboxToPlayer(player)
                end
            end
        end
    end

    -- If ESP enabled, update highlight colors every frame for snappiness (even though 1s loop does it too)
    if espEnabled then
        for player, hl in pairs(highlights) do
            if hl and hl.Parent and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                if espVisibleCheck then
                    hl.FillColor = isPartVisibleToCamera(player.Character.HumanoidRootPart) and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,0,0)
                else
                    hl.FillColor = Color3.fromRGB(255,255,0)
                end
            end
        end
    end
end)

-- Speed boost: joystick-aware using Humanoid.MoveDirection, applied on Heartbeat for physics timing
RunService.Heartbeat:Connect(function()
    if not speedEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    local moveDir = hum.MoveDirection
    if moveDir.Magnitude > 0.01 then
        -- preserve vertical velocity
        local vy = root.Velocity.Y
        root.Velocity = Vector3.new(moveDir.X * SPEED_VALUE, vy, moveDir.Z * SPEED_VALUE)
    end
end)
