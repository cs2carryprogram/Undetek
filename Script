-- small helpers for building controls
local function newButton(parent, text, order)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 220, 0, 30)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    b.TextColor3 = Color3.fromRGB(200, 180, 255)
    b.Font = Enum.Font.Code
    b.TextSize = 14
    b.Text = text
    b.LayoutOrder = order or 1
    b.Parent = parent
    return b
end

local function newTextbox(parent, placeholder, order)
    local t = Instance.new("TextBox")
    t.Size = UDim2.new(0, 220, 0, 30)
    t.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    t.PlaceholderText = placeholder
    t.TextColor3 = Color3.fromRGB(220, 220, 220)
    t.Font = Enum.Font.Code
    t.TextSize = 14
    t.LayoutOrder = order or 1
    t.Parent = parent
    return t
end

